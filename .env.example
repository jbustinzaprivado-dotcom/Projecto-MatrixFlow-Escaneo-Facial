# [Añadido en el repaso de fidelidad §16-21, PDF §17]
# Copia este archivo a ".env" (nunca commiteado) y ajusta los valores reales.
# `docker-compose.yml` y `backend/app/core/config.py` leen estas variables.

# --- Backend ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATABASE_URL=postgresql+psycopg2://matrixflow:matrixflow_dev@localhost:5432/matrixflow
CORS_ORIGINS=["http://localhost:5173"]
JWT_EXPIRE_MINUTES=480

# --- PostgreSQL (usado por docker-compose.yml para levantar el contenedor `db`) ---
POSTGRES_USER=matrixflow
POSTGRES_PASSWORD=matrixflow_dev
POSTGRES_DB=matrixflow

# --- Frontend (se incrusta en el build de Vite, no es secreto) ---
VITE_API_URL=http://localhost:8000
